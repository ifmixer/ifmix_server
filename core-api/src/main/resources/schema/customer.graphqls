type Query {
    todo_get(id: ID!): Todo
    todo_list(cursor: String, limit: Int, userId: String): TodoConnection!

    scan_get(id: ID!): ScanRecord
    scan_list(cursor: String, limit: Int, collected: Boolean): ScanConnection!
    collection_getDefault: Collection!
    collectionItem_list(collectionId: ID, cursor: String, limit: Int): CollectionItemConnection!
    appConfig_getCurrent: AppConfigRevision
}

type Mutation {
    # Customer
    todo_create(input: CreateTodoInput!): Todo! @requirePermission(permission: "todo:write")
    todo_update(id: ID!, input: UpdateTodoInput!): Todo! @requirePermission(permission: "todo:write")
    todo_delete(id: ID!): Boolean! @requirePermission(permission: "todo:write")
    todoItem_create(todoId: ID!, input: CreateTodoItemInput!): TodoItem! @requirePermission(permission: "todo:write")
    todoItem_update(id: ID!, input: UpdateTodoItemInput!): TodoItem! @requirePermission(permission: "todo:write")
    todoItem_delete(id: ID!): Boolean! @requirePermission(permission: "todo:write")

    # Scan
    scan_create(input: NewScanInput!): ScanRecord! @requirePermission(permission: "scan:write")
    scan_update(id: ID!, collected: Boolean): Boolean! @requirePermission(permission: "scan:write")
    scan_delete(id: ID!): Boolean! @requirePermission(permission: "scan:write")

    # Storage
    storage_presignUpload(input: PresignUploadInput!): PresignUploadResult! @requirePermission(permission: "storage:write")
    storage_presignDownload(input: PresignDownloadInput!): PresignDownloadResult! @requirePermission(permission: "storage:read")

    # Collection
    collectionItem_add(collectionId: ID, scanRecordId: ID!): ID! @requirePermission(permission: "collection:write")
    collectionItem_remove(collectionId: ID, scanRecordIds: [ID!]!): Int! @requirePermission(permission: "collection:write")

    # Feedback
    feedback_submit(input: SubmitFeedbackInput!): ID! @requirePermission(permission: "feedback:write")

    # IAP
    iap_verifyPurchase(input: VerifyPurchaseInput!): VerifyPurchaseResult! @requirePermission(permission: "iap:write")
}
