type Query {
    todo_get(id: ID!): Todo
    todo_list(cursor: String, limit: Int, userId: String): TodoConnection!

    query_ai_findScanById(id: ID!): ScanRecord
    query_ai_listScans(cursor: String, limit: Int, collected: Boolean): ScanConnection!
    query_ai_getDefaultCollection: Collection!
    query_ai_listCollectionItems(collectionId: ID, cursor: String, limit: Int): CollectionItemConnection!
    query_app_getCurrentConfig: AppConfigRevision

    # Auth
    query_auth_me: AuthUser!
}

type Mutation {
    # Customer
    todo_create(input: CreateTodoInput!): Todo! @requirePermission(permission: "todo:write")
    todo_update(id: ID!, input: UpdateTodoInput!): Todo! @requirePermission(permission: "todo:write")
    todo_delete(id: ID!): Boolean! @requirePermission(permission: "todo:write")
    todoItem_create(todoId: ID!, input: CreateTodoItemInput!): TodoItem! @requirePermission(permission: "todo:write")
    todoItem_update(id: ID!, input: UpdateTodoItemInput!): TodoItem! @requirePermission(permission: "todo:write")
    todoItem_delete(id: ID!): Boolean! @requirePermission(permission: "todo:write")

    # Scan
    mutation_ai_createScan(input: NewScanInput!): ScanRecord! @requirePermission(permission: "scan:write")
    mutation_ai_updateScan(id: ID!, collected: Boolean): ScanRecord! @requirePermission(permission: "scan:write")
    mutation_ai_deleteScan(id: ID!): Boolean! @requirePermission(permission: "scan:write")

    # Storage
    mutation_storage_presignUpload(input: PresignUploadInput!): PresignUploadResult! @requirePermission(permission: "storage:write")
    mutation_storage_presignDownload(input: PresignDownloadInput!): PresignDownloadResult! @requirePermission(permission: "storage:read")

    # Collection
    mutation_ai_addCollectionItem(collectionId: ID, scanRecordId: ID!): ID! @requirePermission(permission: "collection:write")
    mutation_ai_removeCollectionItems(collectionId: ID, scanRecordIds: [ID!]!): Int! @requirePermission(permission: "collection:write")

    # CMS (Feedback)
    mutation_cms_submitFeedback(input: SubmitFeedbackInput!): ID! @requirePermission(permission: "feedback:write")

    # IAP
    mutation_payment_verifyPurchase(input: VerifyPurchaseInput!): VerifyPurchaseResult! @requirePermission(permission: "iap:write")

    # Auth
    mutation_auth_loginGoogle(input: LoginInput!): AuthResult!
    mutation_auth_loginApple(input: LoginInput!): AuthResult!
    mutation_auth_exchange(input: ExchangeInput!): AuthResult!
    mutation_auth_refresh(input: RefreshInput!): AuthResult!
    mutation_auth_logout(input: LogoutInput!): Boolean!
}
