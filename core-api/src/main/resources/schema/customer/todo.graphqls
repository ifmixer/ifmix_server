type Todo {
    id: UUID!
    title: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    meta: JSON
    items: [TodoItem!]!
    createdAt: DateTime!
    updatedAt: DateTime
}

type TodoItem {
    id: UUID!
    content: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    createdAt: DateTime!
    updatedAt: DateTime
}

# --- Query ---
input TodoQueryInput {
    cursor: String
    limit: Int
}

type TodoPage {
    items: [Todo!]!
    nextCursor: String
    hasMore: Boolean!
}

extend type Query {
    query_todo_findById(id: UUID!): Todo!
    query_todo_findByCursor(input: TodoQueryInput): TodoPage!
    query_todo_findByIds(ids: [UUID!]!): [Todo!]!
}

# --- Mutation: Create ---
input CreateTodoInput {
    title: String!
    done: Boolean
    note: String
    items: [CreateTodoItemInput!]   # 嵌入子实体
}

input CreateTodoItemInput {
    content: String!
    done: Boolean
    note: String
}

type CreateTodoPayload {
    todo: Todo!
}

# --- Mutation: Update Todo ---
input UpdateTodoInput {
    id: UUID!
    set: UpdateTodoSetInput
    unset: [TodoUnsetField!]
}

input UpdateTodoSetInput {
    title: String
    done: Boolean
    note: String
}

enum TodoUnsetField {
    NOTE
}

type UpdateTodoPayload {
    success: Boolean!
    todo: Todo
}

# --- Mutation: Update TodoItems（独立，不需要 todoId） ---
input UpdateTodoItemsMutationInput {
    create: [CreateTodoItemForTodoInput!]
    update: [UpdateTodoItemInput!]
    delete: [UUID!]
}

input CreateTodoItemForTodoInput {
    todoId: UUID!                  # 新建时需要指定挂到哪个 todo
    content: String!
    done: Boolean
    note: String
}

input UpdateTodoItemInput {
    id: UUID!                      # 通过 id 定位，不需要 todoId
    set: UpdateTodoItemSetInput
    unset: [TodoItemUnsetField!]
}

input UpdateTodoItemSetInput {
    content: String
    done: Boolean
    note: String
}

enum TodoItemUnsetField {
    NOTE
}

type UpdateTodoItemsPayload {
    success: Boolean!
}

# --- Mutation: Delete ---
type DeleteTodoPayload {
    success: Boolean!
}

extend type Mutation {
    mutation_todo_create(input: CreateTodoInput!): CreateTodoPayload!
    mutation_todo_update(input: UpdateTodoInput!): UpdateTodoPayload!
    mutation_todoItem_batchUpdate(input: UpdateTodoItemsMutationInput!): UpdateTodoItemsPayload!
    mutation_todo_delete(id: UUID!): DeleteTodoPayload!
    mutation_todo_batchDelete(ids: [UUID!]!): DeleteTodoPayload!
}
