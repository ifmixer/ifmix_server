input SubmitFeedbackInput {
    scanRecordId: UUID
    """ 反馈来源主题: 10=Scan, 20=DeepResearch, 30=App """
    topic: Int!
    """
    反馈原因（多选）:
    0=UNKNOWN, 10=LIKED, 20=PRICE_TOO_HIGH, 21=PRICE_TOO_LOW,
    22=PRICE_MISSING, 23=PRICE_UNREASONABLE, 30=WRONG_IDENTIFICATION, 40=FEATURE_REQUEST,
    41=MORE_RECOMMENDATIONS, 50=WRONG_DATING, 51=WRONG_ORIGIN,
    52=WRONG_CONDITION, 53=WRONG_RARITY, 60=HELPFUL_TIPS
    """
    reasons: [Int!]!
    """ 所在页面区块（如 valuation / dating / condition / authenticity 等），用于定位反馈来源 """
    section: String
    """ SPM 埋点位置标识，用于精确定位反馈触发点 """
    spm: String
    comment: String
    """ 可选联系方式：邮箱（回访用） """
    email: String
    """ 可选联系方式：手机号（回访用） """
    phone: String
}

type SubmitFeedbackResult {
    id: UUID!
}

# ==================== Support Request（工单 / 意见反馈）====================

"用户支持工单。customer 侧仅创建 + 查询自己的工单；agent 侧流转/回复接口未实现（字段已预留）。"
type SupportRequest {
    id: UUID!
    title: String!
    message: String!
    email: String
    phone: String
    "工单分类 Int 码（0=UNSPECIFIED,10=BUG,20=FEATURE_REQUEST,30=ACCOUNT,40=PAYMENT,50=CONTENT_ERROR,100=OTHER；允许未登记值）"
    category: Int!
    "工单状态 Int 码：10=OPEN,20=IN_PROGRESS,30=PENDING_CUSTOMER,40=RESOLVED,50=CLOSED"
    status: Int!
    attachments: [MediaRef!]
    locale: String
    country: String
    currency: String
    createdAt: DateTime!
    updatedAt: DateTime
    firstRepliedAt: DateTime
    lastAgentRepliedAt: DateTime
    lastCustomerRepliedAt: DateTime
    resolvedAt: DateTime
    closedAt: DateTime
}

type SupportRequestPage {
    items: [SupportRequest!]!
    pageInfo: PageInfo!
}

"创建工单。身份/installId/locale 由 header 推导；status 固定 OPEN，客户端不可指定。"
input CreateSupportRequestInput {
    title: String!
    message: String!
    "工单分类 Int 码，默认 0，允许未登记值"
    category: Int! = 0
    email: String
    phone: String
    attachments: [MediaInput!]
}

type CreateSupportRequestResult {
    id: UUID!
}

input ListSupportRequestsInput {
    cursor: String
    limit: Int
}

extend type Mutation {
    m_cs_submitFeedback(input: SubmitFeedbackInput!): SubmitFeedbackResult!
    "创建工单（意见反馈 / 联系我们）。"
    m_cs_createSupportRequest(input: CreateSupportRequestInput!): CreateSupportRequestResult!
}

extend type Query {
    "我的工单详情（需登录，仅本人）。"
    q_cs_mySupportRequestById(id: UUID!): SupportRequest!
    "我的工单列表（需登录，按创建时间倒序游标翻页）。"
    q_cs_mySupportRequests(input: ListSupportRequestsInput): SupportRequestPage!
}
