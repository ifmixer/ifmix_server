type ScanCollection {
    id: UUID!
    isDefault: Boolean!
    createdAt: DateTime!
}

type ScanCollectionItem {
    id: UUID!
    scanRecord: ScanRecord!
    createdAt: DateTime!
}

type ScanCollectionItemPage {
    items: [ScanCollectionItem!]!
    nextCursor: String
    hasMore: Boolean!
}

input ListScanCollectionItemsInput {
    cursor: String
    limit: Int
}

extend type Query {
    query_collection_getDefaultCollection: ScanCollection!
    query_collection_findCollectionItemsByCursor(input: ListScanCollectionItemsInput): ScanCollectionItemPage!
}

input AddScanCollectionItemInput {
    scanRecordId: UUID!
}

type AddScanCollectionItemPayload {
    collectionId: UUID!
    alreadyExists: Boolean!
}

input RemoveScanCollectionItemsInput {
    scanRecordIds: [UUID!]!
}

type RemoveScanCollectionItemsPayload {
    removedCount: Int!
}

extend type Mutation {
    mutation_collection_addCollectionItem(input: AddScanCollectionItemInput!): AddScanCollectionItemPayload!
    mutation_collection_removeCollectionItems(input: RemoveScanCollectionItemsInput!): RemoveScanCollectionItemsPayload!
}
