# schema/customer/ai.graphqls

# ==================== Scan ====================

type ScanRecordListView {
    id: UUID!
    images: [ImageRef!]
    "扫描状态。10=PENDING, 11=PROCESSING, 20=COMPLETED, 30=FAILED"
    status: Int!
    basicResult: JSON
    locale: String
    country: String
    currency: String
    userDisplayName: String
    userNotes: String
    collected: Boolean!
    isPublic: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime
}

"详情视图，包含扫描结果"
type ScanRecord {
    id: UUID!
    createdAt: DateTime!
    updatedAt: DateTime
    isPublic: Boolean!
    "扫描状态。10=PENDING, 11=PROCESSING, 20=COMPLETED, 30=FAILED"
    status: Int!
    locale: String
    country: String
    currency: String
    userDisplayName: String
    userNotes: String
    collected: Boolean!
    hasDeepSearch: Boolean!
    #    promptVersion: String!
    images: [ImageRef!]
    "基础扫描结果 (JSONB)"
    basicResult: JSON
    "当前有效（最新且成功）的 deep research，按 latest_deep_research_id 权威指针加载 (DataLoader)"
    latestDeepResearch: ScanDeepResearch
}

"DeepResearch 任务（历史版本，结果 doc 存 R2）"
type ScanDeepResearch {
    id: UUID!
    scanRecordId: UUID!
    "SUCCESS 时返回：结果 doc 的 presigned download URL（前端据此下载 premiumResult）"
    resultUrl: String
    "旧数据兼容：仅旧 DB 行走 premium_result 列返回；新 R2 数据为 null，走 resultUrl"
    premiumResult: JSON
    createdAt: DateTime!
    updatedAt: DateTime
}

type ImageRef {
    key: String!
    """
    图片分类（Int 码，详见 docs/DATABASE.md）：
    0=MAIN(主图/默认), 10=FRONT(正面), 20=BACK(背面), 30=BOTTOM(底部),
    40=MAKER_MARK(款识/签名), 50=DAMAGE(损伤), 60=DIMENSIONS(尺寸/带参照物),
    70=PRICE_TAG(价签), 80=DOCUMENTS(文件/来源证明), 90=DETAIL(局部细节), 100=OTHER(其它)
    """
    category: Int
}

type ScanRecordListViewPage {
    items: [ScanRecordListView!]!
    pageInfo: PageInfo!
}

input NewScanInput {
    images: [NewScanImageInput!]!
    "是否创建时即收藏（客户端「自动收藏」开关开启时传 true）；省略默认 false"
    collected: Boolean
}

input NewScanImageInput {
    imageKey: String!
    """
    图片分类（Int 码，详见 docs/DATABASE.md）：
    0=MAIN(主图/默认), 10=FRONT(正面), 20=BACK(背面), 30=BOTTOM(底部),
    40=MAKER_MARK(款识/签名), 50=DAMAGE(损伤), 60=DIMENSIONS(尺寸/带参照物),
    70=PRICE_TAG(价签), 80=DOCUMENTS(文件/来源证明), 90=DETAIL(局部细节), 100=OTHER(其它)
    省略时服务端默认按主图(0)入库。
    """
    category: Int
    mediaType: String
}

type NewScanResult {
    scanRecord: ScanRecord
}

input UpdateScanInput {
    id: UUID!
    set: UpdateScanSetInput
    unset: [ScanUnsetField!]
}

input UpdateScanSetInput {
    userDisplayName: String
    userNotes: String
    collected: Boolean
    isPublic: Boolean
}

enum ScanUnsetField { USER_DISPLAY_NAME, USER_NOTES }

type UpdateScanResult {
    success: Boolean!
    scanRecord: ScanRecord
}

"批量更新 scan（当前主要用于批量设置 collected）。仅影响调用者本人拥有的记录。"
input BatchUpdateScanInput {
    "要更新的 scan id 列表（仅本人拥有的会被更新）"
    ids: [UUID!]!
    set: BatchUpdateScanSetInput!
}

input BatchUpdateScanSetInput {
    collected: Boolean
    isPublic: Boolean
}

type BatchUpdateScanResult {
    "实际更新的记录数（不属于调用者的 id 不计入）"
    updatedCount: Int!
}

type DeleteScanResult {
    success: Boolean!
}

input RunDeepResearchInput {
    scanRecordId: UUID!
    images: [DeepResearchImageInput!]!
}

input DeepResearchImageInput {
    imageKey: String!
    """
    图片分类（Int 码，详见 docs/DATABASE.md）：
    0=MAIN(主图/默认), 10=FRONT(正面), 20=BACK(背面), 30=BOTTOM(底部),
    40=MAKER_MARK(款识/签名), 50=DAMAGE(损伤), 60=DIMENSIONS(尺寸/带参照物),
    70=PRICE_TAG(价签), 80=DOCUMENTS(文件/来源证明), 90=DETAIL(局部细节), 100=OTHER(其它)
    """
    category: Int
    mediaType: String
}

type RunDeepResearchResult {
    "新建的 deep research 任务 id，前端据此轮询"
    deepResearchId: UUID!
    "任务状态：20=IN_PROGRESS（创建即此值）"
    status: Int!
}

"DeepResearch 任务状态（轮询专用，不含结果内容）"
type DeepResearchStatus {
    deepResearchId: UUID!
    "20=IN_PROGRESS, 30=SUCCESS, 40=FAILED"
    status: Int!
    "FAILED 时返回：稳定错误码（AI_FAILED/AI_STATUS_REJECTED/R2_UPLOAD_FAILED/TIMEOUT）"
    errorCode: String
    "FAILED 且 AI_STATUS_REJECTED 时返回 scan_status（供前端提示补拍）"
    scanStatus: JSON
}

# ==================== Collection ====================

type ScanCollection {
    id: UUID!
    isDefault: Boolean!
    createdAt: DateTime!
}

type ScanCollectionItem {
    id: UUID!
    scanRecord: ScanRecord!
    createdAt: DateTime!
}

type ScanCollectionItemPage {
    items: [ScanCollectionItem!]!
    pageInfo: PageInfo!
}

input ListScanCollectionItemsInput {
    cursor: String
    limit: Int
}

input AddScanCollectionItemInput {
    scanRecordId: UUID!
}

type AddScanCollectionItemResult {
    collectionId: UUID!
    alreadyExists: Boolean!
}

input RemoveScanCollectionItemsInput {
    scanRecordIds: [UUID!]!
}

type RemoveScanCollectionItemsResult {
    removedCount: Int!
}

# ==================== Query ====================

extend type Query {
    q_ai_findMyScanById(id: UUID!): ScanRecord!
    "通用动态过滤查询（支持 AND/OR 嵌套条件）"
    q_ai_findMyScans(findOptions: CommonFindOptions): ScanRecordListViewPage!
    "按 deepResearchId 轮询任务状态（仅返回状态，不含结果内容；SUCCESS 后前端另调 q_ai_findMyScanById 取权威结果指针）"
    q_ai_getDeepResearchStatus(deepResearchId: UUID!): DeepResearchStatus!
    q_ai_getDefaultCollection: ScanCollection!
    q_ai_findCollectionItemsByCursor(input: ListScanCollectionItemsInput): ScanCollectionItemPage!
}

# ==================== Mutation ====================

extend type Mutation {
    m_ai_createScan(input: NewScanInput!): NewScanResult!
    m_ai_runDeepResearch(input: RunDeepResearchInput!): RunDeepResearchResult!
    m_ai_updateScan(input: UpdateScanInput!): UpdateScanResult!
    m_ai_batchUpdateScan(input: BatchUpdateScanInput!): BatchUpdateScanResult!
    m_ai_deleteScan(id: UUID!): DeleteScanResult!
    m_ai_addCollectionItem(input: AddScanCollectionItemInput!): AddScanCollectionItemResult!
    m_ai_removeCollectionItems(input: RemoveScanCollectionItemsInput!): RemoveScanCollectionItemsResult!
}
