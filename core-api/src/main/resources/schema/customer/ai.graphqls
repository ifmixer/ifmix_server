# schema/customer/ai.graphqls

# ==================== Scan ====================

type ScanRecordListView {
    id: UUID!
    images: [ImageRef!]
    "扫描任务状态。10=CREATED, 20=IN_PROGRESS, 30=SUCCESS, 40=FAILED；AI 业务结论读取 basicResult.scan_status"
    status: Int!
    errorCode: String
    basicResult: JSON
    locale: String
    country: String
    currency: String
    userDisplayName: String
    userNotes: String
    collected: Boolean!
    isPublic: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime
}

"详情视图，包含扫描结果"
type ScanRecord {
    id: UUID!
    createdAt: DateTime!
    updatedAt: DateTime
    isPublic: Boolean!
    "扫描任务状态。10=CREATED, 20=IN_PROGRESS, 30=SUCCESS, 40=FAILED；AI 业务结论读取 basicResult.scan_status"
    status: Int!
    errorCode: String
    locale: String
    country: String
    currency: String
    userDisplayName: String
    userNotes: String
    collected: Boolean!
    hasDeepSearch: Boolean!
    #    promptVersion: String!
    images: [ImageRef!]
    "基础扫描结果 (JSONB)"
    basicResult: JSON
    "当前有效（最新且成功）的 deep research，按 latest_deep_research_id 权威指针加载 (DataLoader)"
    latestDeepResearch: ScanDeepResearch
}

"DeepResearch 任务（历史版本，premium_result 存 PG）"
type ScanDeepResearch {
    id: UUID!
    scanRecordId: UUID!
    "高级扫描结果（JSONB，直接来自 PG premium_result 列）"
    premiumResult: JSON
    createdAt: DateTime!
    updatedAt: DateTime
}

type ImageRef {
    key: String!
    """
    图片分类（Int 码，详见 docs/guide/DATABASE.md）：
    0=MAIN(主图/默认), 10=FRONT(正面), 20=BACK(背面), 30=BOTTOM(底部),
    40=MAKER_MARK(款识/签名), 50=DAMAGE(损伤), 60=DIMENSIONS(尺寸/带参照物),
    70=PRICE_TAG(价签), 80=DOCUMENTS(文件/来源证明), 90=DETAIL(局部细节), 100=OTHER(其它)
    """
    category: Int
}

type ScanRecordListViewPage {
    items: [ScanRecordListView!]!
    pageInfo: PageInfo!
}

input NewScanInput {
    images: [NewScanImageInput!]!
    "是否创建时即收藏（客户端「自动收藏」开关开启时传 true）；省略默认 false"
    collected: Boolean
    featureFlags: ScanFeatureFlagsInput
}

input ScanFeatureFlagsInput {
    "scan 结果 push 是否启用；省略或 false 时后端不发 push"
    scanResultPushEnabled: Boolean
}

input NewScanImageInput {
    imageKey: String!
    """
    图片分类（Int 码，详见 docs/guide/DATABASE.md）：
    0=MAIN(主图/默认), 10=FRONT(正面), 20=BACK(背面), 30=BOTTOM(底部),
    40=MAKER_MARK(款识/签名), 50=DAMAGE(损伤), 60=DIMENSIONS(尺寸/带参照物),
    70=PRICE_TAG(价签), 80=DOCUMENTS(文件/来源证明), 90=DETAIL(局部细节), 100=OTHER(其它)
    省略时服务端默认按主图(0)入库。
    """
    category: Int
    mediaType: String
}

type NewScanResult {
    scanId: UUID!
    "20=IN_PROGRESS，executor 提交失败时为 40"
    status: Int!
    "FAILED 时返回技术错误码"
    errorCode: String
}

"Scan 任务状态（轮询专用，不含结果内容）"
type ScanStatus {
    scanId: UUID!
    "20=IN_PROGRESS, 30=SUCCESS, 40=FAILED"
    status: Int!
    errorCode: String
}

input UpdateScanInput {
    id: UUID!
    set: UpdateScanSetInput
    unset: [ScanUnsetField!]
}

input UpdateScanSetInput {
    userDisplayName: String
    userNotes: String
    collected: Boolean
    isPublic: Boolean
}

enum ScanUnsetField { USER_DISPLAY_NAME, USER_NOTES }

type UpdateScanResult {
    success: Boolean!
    scanRecord: ScanRecord
}

"批量更新 scan（当前主要用于批量设置 collected）。仅影响调用者本人拥有的记录。"
input BatchUpdateScanInput {
    "要更新的 scan id 列表（仅本人拥有的会被更新）"
    ids: [UUID!]!
    set: BatchUpdateScanSetInput!
}

input BatchUpdateScanSetInput {
    collected: Boolean
    isPublic: Boolean
}

type BatchUpdateScanResult {
    "实际更新的记录数（不属于调用者的 id 不计入）"
    updatedCount: Int!
}

type DeleteScanResult {
    success: Boolean!
}

input RunDeepResearchInput {
    scanRecordId: UUID!
    images: [DeepResearchImageInput!]!
    featureFlags: DeepResearchFeatureFlagsInput
}

input DeepResearchFeatureFlagsInput {
    "deep research push 是否启用；省略或 false 时后端不发 push"
    deepResearchPushEnabled: Boolean
}

input DeepResearchImageInput {
    imageKey: String!
    """
    图片分类（Int 码，详见 docs/guide/DATABASE.md）：
    0=MAIN(主图/默认), 10=FRONT(正面), 20=BACK(背面), 30=BOTTOM(底部),
    40=MAKER_MARK(款识/签名), 50=DAMAGE(损伤), 60=DIMENSIONS(尺寸/带参照物),
    70=PRICE_TAG(价签), 80=DOCUMENTS(文件/来源证明), 90=DETAIL(局部细节), 100=OTHER(其它)
    """
    category: Int
    mediaType: String
}

type RunDeepResearchResult {
    "新建的 deep research 任务 id，前端据此轮询"
    deepResearchId: UUID!
    "任务状态：20=IN_PROGRESS（创建即此值）；executor 提交失败时直接返回 40"
    status: Int!
    "status=40 时返回：稳定错误码（TASK_SUBMISSION_FAILED）；IN_PROGRESS 时为 null"
    errorCode: String
}

"DeepResearch 任务状态（轮询专用，不含结果内容）"
type DeepResearchStatus {
    deepResearchId: UUID!
    "20=IN_PROGRESS, 30=SUCCESS, 40=FAILED"
    status: Int!
    "FAILED 时返回：稳定错误码（AI_FAILED/TIMEOUT/TASK_SUBMISSION_FAILED/INTERNAL_ERROR）"
    errorCode: String
}

# ==================== Collection ====================

type ScanCollection {
    id: UUID!
    isDefault: Boolean!
    createdAt: DateTime!
}

type ScanCollectionItem {
    id: UUID!
    scanRecord: ScanRecord!
    createdAt: DateTime!
}

type ScanCollectionItemPage {
    items: [ScanCollectionItem!]!
    pageInfo: PageInfo!
}

input ListScanCollectionItemsInput {
    cursor: String
    limit: Int
}

input AddScanCollectionItemInput {
    scanRecordId: UUID!
}

type AddScanCollectionItemResult {
    collectionId: UUID!
    alreadyExists: Boolean!
}

input RemoveScanCollectionItemsInput {
    scanRecordIds: [UUID!]!
}

type RemoveScanCollectionItemsResult {
    removedCount: Int!
}

# ==================== Query ====================

extend type Query {
    q_ai_scan_getById(id: UUID!): ScanRecord!
    "通用动态过滤查询（支持 AND/OR 嵌套条件）"
    q_ai_scan_listMy(findOptions: CommonFindOptions): ScanRecordListViewPage!
    q_ai_scan_getStatus(scanId: UUID!): ScanStatus!
    "按 deepResearchId 轮询任务状态（仅返回状态，不含结果内容；SUCCESS 后前端另调 q_ai_scan_getById 取权威结果指针）"
    q_ai_deepResearch_getStatus(deepResearchId: UUID!): DeepResearchStatus!
    q_ai_collection_getDefault: ScanCollection!
    q_ai_collectionItem_listMy(input: ListScanCollectionItemsInput): ScanCollectionItemPage!
}

# ==================== Mutation ====================

extend type Mutation {
    m_ai_scan_createOne(input: NewScanInput!): NewScanResult!
    m_ai_deepResearch_run(input: RunDeepResearchInput!): RunDeepResearchResult!
    m_ai_scan_updateMyOne(input: UpdateScanInput!): UpdateScanResult!
    m_ai_scan_updateMyMany(input: BatchUpdateScanInput!): BatchUpdateScanResult!
    m_ai_scan_deleteMyOne(id: UUID!): DeleteScanResult!
    m_ai_collectionItem_add(input: AddScanCollectionItemInput!): AddScanCollectionItemResult!
    m_ai_collectionItem_removeMyMany(input: RemoveScanCollectionItemsInput!): RemoveScanCollectionItemsResult!
}
