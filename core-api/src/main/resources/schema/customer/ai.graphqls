# schema/customer/ai.graphqls

# ==================== Scan ====================

type ScanRecord {
    id: UUID!
    images: [ImageRef!]!
    "基础扫描结果 (JSONB)"
    basicResult: JSON
    "高级扫描结果 (JSONB)"
    premiumResult: JSON
    "扫描状态。100=PENDING, 110=PROCESSING, 200=COMPLETED, 300=FAILED"
    status: Int!
    clientIp: String
    lang: String
    country: String
    currency: String
    userDisplayName: String
    userNotes: String
    collected: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime
}

type ImageRef {
    key: String!
}

input ScanQueryInput {
    cursor: String
    limit: Int
    collected: Boolean
}

type ScanRecordPage {
    items: [ScanRecord!]!
    nextCursor: String
    hasMore: Boolean!
}

input NewScanInput {
    images: [NewScanImageInput!]!
}

input NewScanImageInput {
    imageKey: String!
    mediaType: String
}

type NewScanPayload {
    scanRecord: ScanRecord!
}

input UpdateScanInput {
    id: UUID!
    set: UpdateScanSetInput
    unset: [ScanUnsetField!]
}

input UpdateScanSetInput {
    userDisplayName: String
    userNotes: String
    collected: Boolean
}

enum ScanUnsetField { USER_DISPLAY_NAME, USER_NOTES }

type UpdateScanPayload {
    success: Boolean!
    scanRecord: ScanRecord
}

type DeleteScanPayload {
    success: Boolean!
}

# ==================== Collection ====================

type ScanCollection {
    id: UUID!
    isDefault: Boolean!
    createdAt: DateTime!
}

type ScanCollectionItem {
    id: UUID!
    scanRecord: ScanRecord!
    createdAt: DateTime!
}

type ScanCollectionItemPage {
    items: [ScanCollectionItem!]!
    nextCursor: String
    hasMore: Boolean!
}

input ListScanCollectionItemsInput {
    cursor: String
    limit: Int
}

input AddScanCollectionItemInput {
    scanRecordId: UUID!
}

type AddScanCollectionItemPayload {
    collectionId: UUID!
    alreadyExists: Boolean!
}

input RemoveScanCollectionItemsInput {
    scanRecordIds: [UUID!]!
}

type RemoveScanCollectionItemsPayload {
    removedCount: Int!
}

# ==================== Query ====================

extend type Query {
    q_ai_findScanById(id: UUID!): ScanRecord!
    q_ai_findScansByCursor(input: ScanQueryInput): ScanRecordPage!
    "通用动态过滤查询（支持 AND/OR 嵌套条件）"
    q_ai_findScans(filter: FilterGroup, cursor: String, limit: Int): ScanRecordPage!
    q_ai_getDefaultCollection: ScanCollection!
    q_ai_findCollectionItemsByCursor(input: ListScanCollectionItemsInput): ScanCollectionItemPage!
}

# ==================== Mutation ====================

extend type Mutation {
    m_ai_createScan(input: NewScanInput!): NewScanPayload!
    m_ai_updateScan(input: UpdateScanInput!): UpdateScanPayload!
    m_ai_deleteScan(id: UUID!): DeleteScanPayload!
    m_ai_addCollectionItem(input: AddScanCollectionItemInput!): AddScanCollectionItemPayload!
    m_ai_removeCollectionItems(input: RemoveScanCollectionItemsInput!): RemoveScanCollectionItemsPayload!
}
