input SubmitFeedbackInput {
    scanRecordId: UUID
    "反馈分类。10=LIKED, 20=PRICE_TOO_HIGH, 21=PRICE_TOO_LOW, 22=PRICE_MISSING, 30=WRONG_IDENTIFICATION, 40=FEATURE_REQUEST, 41=MORE_RECOMMENDATIONS"
    category: Int!
    comment: String
}

type SubmitFeedbackResult {
    id: UUID!
}

extend type Mutation {
    m_cms_submitFeedback(input: SubmitFeedbackInput!): SubmitFeedbackResult!
}
