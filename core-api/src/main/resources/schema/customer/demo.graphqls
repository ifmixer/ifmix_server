type Todo {
    id: UUID!
    title: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    meta: JSON
    items: [TodoItem!]!
    createdAt: DateTime!
    updatedAt: DateTime
}

type TodoItem {
    id: UUID!
    content: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    createdAt: DateTime!
    updatedAt: DateTime
}

# --- Query ---
input TodoQueryInput {
    cursor: String
    limit: Int
    filter: TodoFilter
}

input TodoFilter {
    done: Boolean
    userId: UUID
}

type TodoPage {
    items: [Todo!]!
    nextCursor: String
    hasMore: Boolean!
}

extend type Query {
    q_demo_findTodoById(id: UUID!): Todo!
    q_demo_findTodosByCursor(input: TodoQueryInput): TodoPage!
    q_demo_findTodosByIds(ids: [UUID!]!): [Todo!]!
    "动态条件查询（FilterGroup + 游标分页）。可过滤字段: title(String), done(Boolean), userId(UUID), note(String), createdAt(epochMillis), updatedAt(epochMillis)"
    q_demo_findTodos(filter: FilterGroup, cursor: String, limit: Int): TodoPage!
}

# --- Mutation: Create ---
input CreateTodoInput {
    title: String!
    done: Boolean
    note: String
    items: [CreateTodoItemInput!]   # 嵌入子实体
}

input CreateTodoItemInput {
    content: String!
    done: Boolean
    note: String
}

type CreateTodoResult {
    todo: Todo!
}

# --- Mutation: Update Todo ---
input UpdateTodoInput {
    id: UUID!
    set: UpdateTodoSetInput
    unset: [TodoUnsetField!]
}

input UpdateTodoSetInput {
    title: String
    done: Boolean
    note: String
}

enum TodoUnsetField {
    NOTE
}

type UpdateTodoResult {
    success: Boolean!
    todo: Todo
}

# --- Mutation: Update TodoItems（独立，不需要 todoId） ---
input UpdateTodoItemsMutationInput {
    create: [CreateTodoItemForTodoInput!]
    update: [UpdateTodoItemInput!]
    delete: [UUID!]
}

input CreateTodoItemForTodoInput {
    todoId: UUID!                  # 新建时需要指定挂到哪个 todo
    content: String!
    done: Boolean
    note: String
}

input UpdateTodoItemInput {
    id: UUID!                      # 通过 id 定位，不需要 todoId
    set: UpdateTodoItemSetInput
    unset: [TodoItemUnsetField!]
}

input UpdateTodoItemSetInput {
    content: String
    done: Boolean
    note: String
}

enum TodoItemUnsetField {
    NOTE
}

type UpdateTodoItemsResult {
    success: Boolean!
}

# --- Mutation: Delete ---
type DeleteTodoResult {
    success: Boolean!
}

extend type Mutation {
    m_demo_createTodo(input: CreateTodoInput!): CreateTodoResult!
    m_demo_updateTodo(input: UpdateTodoInput!): UpdateTodoResult!
    m_demo_batchUpdateTodoItems(input: UpdateTodoItemsMutationInput!): UpdateTodoItemsResult!
    m_demo_deleteTodo(id: UUID!): DeleteTodoResult!
    m_demo_batchDeleteTodos(ids: [UUID!]!): DeleteTodoResult!
}
