type Todo {
    id: UUID!
    title: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    meta: JSON
    items: [TodoItem!]!
    """DataLoader 演示：嵌套对象方式"""
    metrics: TodoMetrics!
    """DataLoader 演示：独立字段方式（三个字段共享同一个 DataLoader 实例）"""
    itemCount: Int!
    pendingCount: Int!
    finishCount: Int!
    createdAt: DateTime!
    updatedAt: DateTime
}

"""Todo 子项统计指标（由 field resolver + DataLoader 批量解析）"""
type TodoMetrics {
    itemCount: Int!
    pendingItemCount: Int!
    finishedItemCount: Int!
}

type TodoItem {
    id: UUID!
    content: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    createdAt: DateTime!
    updatedAt: DateTime
}

# --- Query ---
input TodoQueryInput {
    cursor: String
    limit: Int
}

type TodoPage {
    items: [Todo!]!
    nextCursor: String
    hasMore: Boolean!
}

"""JOIN 演示：Todo + item 聚合统计"""
type TodoWithStats {
    id: UUID!
    title: String!
    done: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime
    itemCount: Int!           # 子项总数
    pendingItemCount: Int!    # 未完成子项数
}

type TodoWithStatsPage {
    items: [TodoWithStats!]!
    nextCursor: String
    hasMore: Boolean!
}

extend type Query {
    query_demo_findTodoById(id: UUID!): Todo!
    query_demo_findTodosByCursor(input: TodoQueryInput): TodoPage!
    query_demo_findTodosByIds(ids: [UUID!]!): [Todo!]!
    """JOIN 演示：LEFT JOIN core_todo_item + GROUP BY，返回每个 Todo 附带 item 统计"""
    query_demo_findTodosWithStats(input: TodoQueryInput): TodoWithStatsPage!
}

# --- Mutation: Create ---
input CreateTodoInput {
    title: String!
    done: Boolean
    note: String
    items: [CreateTodoItemInput!]   # 嵌入子实体
}

input CreateTodoItemInput {
    content: String!
    done: Boolean
    note: String
}

type CreateTodoPayload {
    todo: Todo!
}

# --- Mutation: Update Todo ---
input UpdateTodoInput {
    id: UUID!
    set: UpdateTodoSetInput
    unset: [TodoUnsetField!]
}

input UpdateTodoSetInput {
    title: String
    done: Boolean
    note: String
}

enum TodoUnsetField {
    NOTE
}

type UpdateTodoPayload {
    success: Boolean!
    todo: Todo
}

# --- Mutation: Update TodoItems（独立，不需要 todoId） ---
input UpdateTodoItemsMutationInput {
    create: [CreateTodoItemForTodoInput!]
    update: [UpdateTodoItemInput!]
    delete: [UUID!]
}

input CreateTodoItemForTodoInput {
    todoId: UUID!                  # 新建时需要指定挂到哪个 todo
    content: String!
    done: Boolean
    note: String
}

input UpdateTodoItemInput {
    id: UUID!                      # 通过 id 定位，不需要 todoId
    set: UpdateTodoItemSetInput
    unset: [TodoItemUnsetField!]
}

input UpdateTodoItemSetInput {
    content: String
    done: Boolean
    note: String
}

enum TodoItemUnsetField {
    NOTE
}

type UpdateTodoItemsPayload {
    success: Boolean!
}

# --- Mutation: Delete ---
type DeleteTodoPayload {
    success: Boolean!
}

extend type Mutation {
    mutation_demo_createTodo(input: CreateTodoInput!): CreateTodoPayload!
    mutation_demo_updateTodo(input: UpdateTodoInput!): UpdateTodoPayload!
    mutation_demo_batchUpdateTodoItems(input: UpdateTodoItemsMutationInput!): UpdateTodoItemsPayload!
    mutation_demo_deleteTodo(id: UUID!): DeleteTodoPayload!
    mutation_demo_batchDeleteTodos(ids: [UUID!]!): DeleteTodoPayload!
}
