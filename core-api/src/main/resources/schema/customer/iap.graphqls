enum Platform { APPLE, GOOGLE }

input VerifyPurchaseInput {
    "购买平台。100=APPLE, 200=GOOGLE"
    platform: Int!
    productId: String!
    signedTransaction: String
    purchaseToken: String
}

type VerifyPurchasePayload {
    "付费等级。100=FREE, 200=PRO, 300=ENTERPRISE"
    tier: Int!
    expiresAt: DateTime
}

extend type Mutation {
    mutation_iap_verifyPurchase(input: VerifyPurchaseInput!): VerifyPurchasePayload!
}
