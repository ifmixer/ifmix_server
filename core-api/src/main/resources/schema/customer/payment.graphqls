input verifyIapPurchaseInput {
    "购买平台。100=APPLE, 200=GOOGLE"
    platform: Int!
    productId: String!
    signedTransaction: String
    purchaseToken: String
}

type verifyIapPurchasePayload {
    "付费等级。100=FREE, 200=PRO, 300=ENTERPRISE"
    tier: Int!
    expiresAt: DateTime
}

extend type Mutation {
    mutation_payment_verifyIapPurchase(input: verifyIapPurchaseInput!): verifyIapPurchasePayload!
}
