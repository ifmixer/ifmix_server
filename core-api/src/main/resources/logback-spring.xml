<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：info/warn/error 分文件落盘（JSON）。
  - 日志目录：${LOG_PATH:-./logs}（可用环境变量 LOG_PATH 覆盖）
  - info 文件：只收 <= INFO（DEBUG/INFO），排除 WARN/ERROR
  - warn 文件：只收 WARN
  - error 文件：只收 ERROR
  - 均按天 + 单文件 50MB 滚动，保留 30 天，总量上限 3GB
  - 控制台仅 local profile 输出，方便本地调试
-->
<!--
  文件与控制台统一为文本格式（一行一条，异常栈跟在后面）。
  2026-10-10 之前文件是 JSON（logstash），实测固定字段占 41.6% 体积且**没有产出任何自定义字段**
  （业务日志跑在虚拟线程上，MDC 不继承），纯属开销；而业务 message 本身就是 `key=value` 自描述，JSON 未提供额外语义。
  - UTC 显式标注：日志时间一律 UTC，跟本地时间对不上先换算。
  - %mdc = LogContext 写入的请求上下文（rid/pid/iid/cid/ip…，见 ActionContext.logFields()），无值时输出空。
  - %kvp = SLF4J key-value（如请求日志的 method/path/httpStatus/duration）。
  - 末尾 %ex：不带异常时输出空；带异常时栈紧跟在 %n 之后（Spring Boot 默认 pattern 同样写法）。
-->
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="core-api"/>

    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <!-- UTC 显式声明（服务器时区就是 UTC，但写出来避免混淆）；%ex 放 %n 之后，无异常时输出空 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS,UTC} [%thread] %-5level %logger{36} [%mdc] - %msg %kvp%n%ex"/>

    <!-- 控制台（仅本地开发） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- INFO 文件：DEBUG/INFO 进这里，WARN/ERROR 被 ThresholdFilter 挡在外面 -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/info.log</file>
        <!-- 只放行 < WARN 的日志（TRACE/DEBUG/INFO） -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/info.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- WARN 文件：只收 WARN -->
    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/warn.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/warn.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ERROR 文件：只收 ERROR -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件写入用异步，降低业务线程阻塞 -->
    <appender name="ASYNC_INFO_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="INFO_FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>
    <appender name="ASYNC_WARN_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="WARN_FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>
    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ERROR_FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- 本地：控制台 + 文件 -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_INFO_FILE"/>
            <appender-ref ref="ASYNC_WARN_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 非本地（uat/prod 等）：只写文件 -->
    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="ASYNC_INFO_FILE"/>
            <appender-ref ref="ASYNC_WARN_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>
</configuration>
