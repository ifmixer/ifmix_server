# ===== 通用动态查询 Filter DSL =====
# 支持 AND/OR 嵌套组合，类似 MongoDB 查询语法。
# 所有表共用，后端通过字段白名单控制可查字段。

enum FilterOp {
  EQ
  NE
  GT
  GTE
  LT
  LTE
  IN
  NIN
  LIKE
  IS_NULL
  IS_NOT_NULL
}

"单个字段条件"
input FieldFilter {
  "字段名（需在后端白名单中）"
  field: String!
  "操作符"
  op: FilterOp!
  "标量值（EQ/NE/GT/GTE/LT/LTE/LIKE 使用）"
  value: JSON
  "数组值（IN/NIN 使用）"
  values: [JSON!]
}

"组合条件（支持嵌套）"
input FilterGroup {
  "所有条件取 AND（与 or 二选一，同时填写则 AND 优先）"
  and: [FilterExpr!]
  "所有条件取 OR"
  or: [FilterExpr!]
}

"条件表达式 = 字段条件 | 嵌套组合（二选一）"
input FilterExpr {
  "字段级条件"
  field: FieldFilter
  "嵌套组合"
  group: FilterGroup
}
