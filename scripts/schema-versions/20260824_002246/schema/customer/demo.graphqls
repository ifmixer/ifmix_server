type Todo {
    id: UUID!
    title: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    meta: JSON
    recommend: TodoRecommend
    items: [TodoItem!]!
    itemCount: Int!
    pendingCount: Int!
    finishCount: Int!
    createdAt: DateTime!
    updatedAt: DateTime
}

type TodoRecommend {
    sectionId: UUID!
    sectionName: String!
    viewCount: Int
    recItems: [TodoRecItem!]
}

type TodoRecItem {
    recId: UUID!
    title: String
    priority: Int!
    createdAt: DateTime!
    updatedAt: DateTime
}

type TodoItem {
    id: UUID!
    content: String!
    done: Boolean!
    note: String          # nullable — 演示 unset
    createdAt: DateTime!
    updatedAt: DateTime
}

# --- Query ---

type TodoPage {
    items: [Todo!]!
    nextCursor: String
    hasMore: Boolean!
}

extend type Query {
    q_demo_findTodoById(id: UUID!): Todo!
    q_demo_findTodosByIds(ids: [UUID!]!): [Todo!]!
    "动态条件查询。可过滤字段: title(String), done(Boolean), userId(UUID), note(String), createdAt(DateTime), updatedAt(DateTime)"
    q_demo_findTodos(findOptions: CommonFindOptions): TodoPage!
}

# --- Mutation: Create ---
input CreateTodoInput {
    title: String!
    done: Boolean
    note: String
    recommend: TodoRecommendInput
    items: [CreateTodoItemInput!]   # 嵌入子实体
}

input CreateTodoItemInput {
    content: String!
    done: Boolean
    note: String
}

input TodoRecommendInput {
    sectionId: UUID!
    sectionName: String!
    viewCount: Int
    recItems: [TodoRecItemInput!]
}

input TodoRecItemInput {
    recId: UUID!
    title: String
    priority: Int!
    createdAt: DateTime!
    updatedAt: DateTime
}

type CreateTodoResult {
    todo: Todo!
}

# --- Mutation: Update Todo ---
input UpdateTodoInput {
    id: UUID!
    set: UpdateTodoSetInput
    unset: [TodoUnsetField!]
}

input UpdateTodoSetInput {
    title: String
    done: Boolean
    note: String
    recommend: TodoRecommendInput
}

enum TodoUnsetField {
    NOTE
    RECOMMEND
}

type UpdateTodoResult {
    success: Boolean!
    todo: Todo
}

# --- Mutation: Update TodoItems（独立，不需要 todoId） ---
input UpdateTodoItemsMutationInput {
    create: [CreateTodoItemForTodoInput!]
    update: [UpdateTodoItemInput!]
    delete: [UUID!]
}

input CreateTodoItemForTodoInput {
    todoId: UUID!
    content: String!
    done: Boolean
    note: String
}

input UpdateTodoItemInput {
    id: UUID!                      # 通过 id 定位，不需要 todoId
    set: UpdateTodoItemSetInput
    unset: [TodoItemUnsetField!]
}

input UpdateTodoItemSetInput {
    content: String
    done: Boolean
    note: String
}

enum TodoItemUnsetField {
    NOTE
}

type UpdateTodoItemsResult {
    success: Boolean!
}

# --- Mutation: Delete ---

extend type Mutation {
    m_demo_createTodo(input: CreateTodoInput!): CreateTodoResult!
    m_demo_updateTodo(input: UpdateTodoInput!): UpdateTodoResult!
    m_demo_batchUpdateTodoItems(input: UpdateTodoItemsMutationInput!): UpdateTodoItemsResult!
    m_demo_deleteTodo(id: UUID!): OperationResult!
    m_demo_deleteTodoByIds(ids: [UUID!]!): OperationResult!
}
