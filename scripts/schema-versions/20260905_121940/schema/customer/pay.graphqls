input verifyIapPurchaseInput {
    "购买平台。10=APPLE, 20=GOOGLE"
    platform: Int!
    productId: String!
    signedTransaction: String
    purchaseToken: String
}

type VerifyIapPurchaseResult {
    "付费等级。10=FREE, 20=PRO, 30=ENTERPRISE"
    tier: Int!
    expiresAt: DateTime
}

extend type Mutation {
    m_pay_verifyIapPurchase(input: verifyIapPurchaseInput!): VerifyIapPurchaseResult!
}
